# Copy to .env and adjust. Used by Docker Compose / local runs.
# Never commit real secrets.

SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ecommerce?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=ecommerce
SPRING_DATASOURCE_PASSWORD=ecommerce

APP_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
APP_JWT_EXPIRATION_MS=604800000
APP_CORS_ALLOWED_ORIGINS=*

APP_STORE_NAME=Karwan
APP_PUBLIC_URL=http://localhost:8080

# Shipping: flat rate below free threshold; free at/above threshold
APP_SHIPPING_FLAT_RATE=9.99
APP_SHIPPING_FREE_THRESHOLD=100

# Flat tax rate on (subtotal - discount), e.g. 0.08 = 8%
APP_TAX_RATE=0.08

# Mail (Mailhog defaults for local: UI http://localhost:8025)
APP_MAIL_ENABLED=true
APP_MAIL_FROM=noreply@karwan.local
SPRING_MAIL_HOST=mailhog
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false
