{
  "info": {
    "_postman_id": "karwan-api-collection-001",
    "name": "Karwan Store API",
    "description": "Karwan ecommerce API collection with login token generators and end-to-end workflows.\n\n## Quick start\n1. Import this collection + an environment.\n2. Run **01 Token Generators → Customer Login** (or Admin Login).\n3. Tokens are saved automatically to `customer_token` / `admin_token`.\n4. Follow folders in order for full workflows.\n\n## Demo accounts\n- Customer: `customer@store.local` / `password123`\n- Admin: `admin@store.local` / `password123`\n- Coupon: `WELCOME10`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "customer_email", "value": "customer@store.local" },
    { "key": "customer_password", "value": "password123" },
    { "key": "admin_email", "value": "admin@store.local" },
    { "key": "admin_password", "value": "password123" },
    { "key": "customer_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "sessionId", "value": "guest-postman-session-1" },
    { "key": "productId", "value": "1" },
    { "key": "productSlug", "value": "" },
    { "key": "cartItemId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "couponId", "value": "" },
    { "key": "couponCode", "value": "WELCOME10" }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "API Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "01 Token Generators",
      "description": "Run these first. Successful responses store JWTs into collection variables for later requests.",
      "item": [
        {
          "name": "Customer Login → save customer_token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('customer_token', json.token);",
                  "  if (pm.environment) { pm.environment.set('customer_token', json.token); }",
                  "  console.log('customer_token saved');",
                  "}",
                  "if (json.customer && json.customer.id) {",
                  "  pm.collectionVariables.set('customerId', String(json.customer.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{customer_password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Generates a customer JWT and stores it as `customer_token`."
          }
        },
        {
          "name": "Admin Login → save admin_token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('admin_token', json.token);",
                  "  if (pm.environment) { pm.environment.set('admin_token', json.token); }",
                  "  console.log('admin_token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/admin/login",
            "description": "Generates an admin JWT and stores it as `admin_token`."
          }
        },
        {
          "name": "Register Customer → save customer_token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('register_email', `buyer.${stamp}@example.com`);",
                  "pm.collectionVariables.set('register_password', 'password123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register succeeded', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('customer_token', json.token);",
                  "  if (pm.environment) { pm.environment.set('customer_token', json.token); }",
                  "}",
                  "if (json.customer) {",
                  "  pm.collectionVariables.set('customer_email', json.customer.email);",
                  "  pm.collectionVariables.set('customerId', String(json.customer.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{register_email}}\",\n  \"password\": \"{{register_password}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Buyer\",\n  \"telephone\": \"+10000000000\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates a new customer and stores the returned JWT as `customer_token`."
          }
        }
      ]
    },
    {
      "name": "02 Catalog (public)",
      "item": [
        {
          "name": "List Categories (tree)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories?tree=true"
          }
        },
        {
          "name": "List Manufacturers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/manufacturers"
          }
        },
        {
          "name": "List Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.items && json.items.length) {",
                  "  pm.collectionVariables.set('productId', String(json.items[0].id));",
                  "  pm.collectionVariables.set('productSlug', json.items[0].slug);",
