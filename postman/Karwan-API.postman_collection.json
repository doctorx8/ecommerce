          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{newCouponCode}}\",\n  \"name\": \"Postman Test Coupon\",\n  \"type\": \"PERCENT\",\n  \"discount\": 15,\n  \"minOrderTotal\": 20,\n  \"maxUses\": 100,\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/admin/coupons"
          }
        },
        {
          "name": "Update Coupon",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{newCouponCode}}\",\n  \"name\": \"Postman Test Coupon Updated\",\n  \"type\": \"PERCENT\",\n  \"discount\": 12,\n  \"minOrderTotal\": 25,\n  \"maxUses\": 50,\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/admin/coupons/{{couponId}}"
          }
        },
        {
          "name": "Delete Coupon",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/admin/coupons/{{couponId}}"
          }
        },
        {
          "name": "Create Product (catalog admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now().toString().slice(-6);",
                  "pm.collectionVariables.set('newSku', 'PM-SKU-' + stamp);",
                  "pm.collectionVariables.set('newSlug', 'postman-product-' + stamp);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('productId', String(json.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo Product\",\n  \"slug\": \"{{newSlug}}\",\n  \"sku\": \"{{newSku}}\",\n  \"model\": \"PM-1\",\n  \"description\": \"Created from Postman\",\n  \"shortDesc\": \"Postman item\",\n  \"price\": 49.99,\n  \"compareAtPrice\": 59.99,\n  \"quantity\": 25,\n  \"stockStatus\": \"IN_STOCK\",\n  \"subtractStock\": true,\n  \"active\": true,\n  \"featured\": false\n}"
            },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo Product Updated\",\n  \"slug\": \"{{newSlug}}\",\n  \"sku\": \"{{newSku}}\",\n  \"model\": \"PM-1\",\n  \"description\": \"Updated from Postman\",\n  \"shortDesc\": \"Postman item\",\n  \"price\": 44.99,\n  \"quantity\": 30,\n  \"stockStatus\": \"IN_STOCK\",\n  \"subtractStock\": true,\n  \"active\": true,\n  \"featured\": true\n}"
            },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        }
      ]
    }
  ]
